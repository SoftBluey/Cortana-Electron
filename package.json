{
  "name": "cortana-electron",
  "version": "7.1.0",
  "description": "A electron app to bring Cortana back to your desktop!",
  "main": "main.js",
  "author": "BlueySoft",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "prestart": "node -e \"const fs=require('fs');if(!fs.existsSync('./.winapp/bindings/index.js')){const{execSync}=require('child_process');execSync('npx winapp restore',{stdio:'inherit'})}\"",
    "postinstall": "electron-builder install-app-deps",
    "generate-bindings": "npx winapp restore",
    "dist": "npx winapp restore && electron-builder"
  },
  "dependencies": {
    "@microsoft/dynwinrt": "0.1.0-preview.19",
    "city-timezones": "^1.3.1",
    "gifuct-js": "^2.1.2",
    "node-edge-tts": "^1.2.10"
  },
  "devDependencies": {
    "@microsoft/dynwinrt-codegen": "0.1.0-preview.19",
    "@microsoft/winappcli": "^0.5.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.7"
  },
  "build": {
    "appId": "com.blueysoft.cortana-electron",
    "productName": "Cortana Electron",
    "icon": "assets/icon.ico",
    "files": [
      "main.js",
      "renderer.js",
      "index.html",
      "style.css",
      ".winapp/bindings/**"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "speech.ps1",
        "to": "speech.ps1"
      }
    ],
    "win": {
      "target": "nsis"
    }
  },
  "overrides": {
    "node-abi": "4.0.0"
  },
  "winapp": {
    "jsBindings": {
      "additionalWinmds": [
        {
          "namespace": "Windows.Media.SpeechRecognition",
          "classes": [
            "SpeechRecognizer",
            "SpeechRecognitionTopicConstraint",
            "SpeechRecognitionListConstraint",
            "SpeechRecognitionResult",
            "SpeechContinuousRecognitionSession",
            "SpeechRecognitionHypothesis"
          ]
        }
      ],
      "additionalRefs": []
    }
  },
  "imports": {
    "#winapp/bindings": {
      "types": "./.winapp/bindings/index.d.ts",
      "import": "./.winapp/bindings/index.mjs",
      "require": "./.winapp/bindings/index.js",
      "default": "./.winapp/bindings/index.js"
    },
    "#winapp/bindings/*": {
      "types": "./.winapp/bindings/*.d.ts",
      "default": "./.winapp/bindings/*.js"
    }
  },
  "allowScripts": {
    "@microsoft/winappcli@0.5.0": true,
    "electron-winstaller@5.4.0": true
  }
}
